rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vishaljogdeoweb@gmail.com'
      );
    }

    // Allow public read on all collections
    match /{document=**} {
      allow read: if true;
    }

    // Songs collection
    match /songs/{songId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays']));
    }

    // Lyrics collection
    match /lyrics/{lyricId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
    }

    // Gallery folders management
    match /gallery_folders/{folderId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Gallery photos management
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
    }

    // Stats counter (allow public read and increment updates)
    match /stats/{statId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Shows management
    match /shows/{showId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Hero banner slides management
    match /hero_slides/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Notifications ticker management
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Event Inquiries (public can create inquiries; read and manage allowed)
    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // FCM tokens for push notifications
    match /fcm_tokens/{tokenId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
