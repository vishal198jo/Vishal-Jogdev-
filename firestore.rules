rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'vishaljogdeoweb@gmail.com'
      );
    }

    // Allow public read on all collections
    match /{document=**} {
      allow read: if true;
    }

    // Songs collection (Admin can create, edit, delete songs; public can increment plays and downloads)
    match /songs/{songId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays', 'downloads']));
    }

    // Lyrics collection (Admin can create, edit, delete lyrics; public can increment views)
    match /lyrics/{lyricId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
    }

    // Gallery folders management (Admin can create, edit/update, and delete folders)
    match /gallery_folders/{folderId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Gallery photos management (Admin can create, edit/update, and delete photos; public can increment views)
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
    }

    // Stats counter (allow public read and increment updates)
    match /stats/{statId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Shows management (Admin can create, edit, delete shows)
    match /shows/{showId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Hero banner slides management (Admin can create, edit, delete slides)
    match /hero_slides/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Notifications ticker management (Admin can create, edit, delete alerts)
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Event Inquiries (public can create inquiries; admin can update, delete)
    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
