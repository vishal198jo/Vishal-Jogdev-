{
  "entities": {
    "Song": {
      "title": "Song",
      "description": "Devotional audio track and album composition",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the song" },
        "singerName": { "type": "string", "description": "Artist or singer name" },
        "titleDevanagari": { "type": "string", "description": "Devanagari script title" },
        "album": { "type": "string", "description": "Album name" },
        "category": { "type": "string", "description": "Category (Bhajan, Kirtan, Aarti, Abhanga)" },
        "language": { "type": "string", "description": "Language of the track" },
        "duration": { "type": "string", "description": "Track duration (e.g. 5:30)" },
        "audioUrl": { "type": "string", "description": "High fidelity audio URL" },
        "coverImage": { "type": "string", "description": "Cover art image URL" },
        "plays": { "type": "number", "description": "Play count" },
        "raga": { "type": "string", "description": "Classical raga" },
        "composer": { "type": "string", "description": "Composer name" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["title", "audioUrl"]
    },
    "Lyric": {
      "title": "Lyric",
      "description": "Song lyrics and metadata for devotional compositions",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the song/lyric" },
        "singerName": { "type": "string", "description": "Singer or composer name" },
        "titleDevanagari": { "type": "string", "description": "Devanagari title" },
        "album": { "type": "string", "description": "Album or collection name" },
        "category": { "type": "string", "description": "Category (Bhajan, Aarti, Abhanga, etc.)" },
        "language": { "type": "string", "description": "Language of the lyrics" },
        "publishedDate": { "type": "string", "description": "Publication date" },
        "coverImage": { "type": "string", "description": "Cover image URL" },
        "raga": { "type": "string", "description": "Classical Raga if applicable" },
        "taal": { "type": "string", "description": "Classical Taal if applicable" },
        "meaningSummary": { "type": "string", "description": "Short explanation or meaning" },
        "devanagariText": { "type": "string", "description": "Lyrics text in Devanagari script" },
        "romanText": { "type": "string", "description": "Lyrics text in Roman transliteration" },
        "metaTitle": { "type": "string", "description": "SEO Meta Title" },
        "metaDescription": { "type": "string", "description": "SEO Meta Description" },
        "createdAt": { "type": "string", "description": "ISO Timestamp when created" }
      },
      "required": ["title", "devanagariText"]
    },
    "GalleryFolder": {
      "title": "GalleryFolder",
      "description": "Folder grouping photo items in the gallery",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Folder name" },
        "coverImage": { "type": "string", "description": "Folder cover image URL" },
        "description": { "type": "string", "description": "Folder description" },
        "count": { "type": "number", "description": "Photo count in folder" },
        "createdAt": { "type": "string", "description": "ISO Timestamp" }
      },
      "required": ["name"]
    },
    "GalleryPhoto": {
      "title": "GalleryPhoto",
      "description": "Photo or video item inside the media gallery",
      "type": "object",
      "properties": {
        "folderId": { "type": "string", "description": "Target folder ID" },
        "folderName": { "type": "string", "description": "Name of the target folder" },
        "imageUrl": { "type": "string", "description": "Full HD Photo or thumbnail URL" },
        "videoUrl": { "type": "string", "description": "Full HD / 4K / HLS Video URL" },
        "type": { "type": "string", "enum": ["photo", "video"], "description": "Media type" },
        "youtubeId": { "type": "string", "description": "YouTube video ID if applicable" },
        "title": { "type": "string", "description": "Media title" },
        "category": { "type": "string", "description": "Category" },
        "description": { "type": "string", "description": "Caption or concert notes" },
        "createdAt": { "type": "string", "description": "ISO Timestamp" }
      },
      "required": ["imageUrl"]
    },
    "Show": {
      "title": "Show",
      "description": "Upcoming or past concert show item",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Show title" },
        "city": { "type": "string", "description": "City name" },
        "venue": { "type": "string", "description": "Venue address" },
        "state": { "type": "string", "description": "State" },
        "date": { "type": "string", "description": "Show Date (YYYY-MM-DD)" },
        "time": { "type": "string", "description": "Show Time" },
        "bannerImage": { "type": "string", "description": "Banner image URL" },
        "description": { "type": "string", "description": "Show overview" },
        "ticketLink": { "type": "string", "description": "Booking pass or ticket link" },
        "isOrganizedByTrust": { "type": "boolean", "description": "Whether organized by trust" },
        "showInNotification": { "type": "boolean", "description": "Whether to feature in homepage notification bar" },
        "createdAt": { "type": "string", "description": "ISO Timestamp" }
      },
      "required": ["title", "date", "venue"]
    },
    "HeroSlide": {
      "title": "HeroSlide",
      "description": "Homepage Hero Banner slide image",
      "type": "object",
      "properties": {
        "image": { "type": "string", "description": "Hero slide image URL" },
        "altText": { "type": "string", "description": "Alt text or title" },
        "order": { "type": "number", "description": "Display order" },
        "createdAt": { "type": "string", "description": "ISO Timestamp" }
      },
      "required": ["image"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Announcement bar notification ticker item",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "Announcement text" },
        "link": { "type": "string", "description": "Target CTA link" },
        "active": { "type": "boolean", "description": "Is active" },
        "createdAt": { "type": "string", "description": "ISO Timestamp" }
      },
      "required": ["text"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Contact and concert booking inquiry submissions",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Sender name" },
        "phone": { "type": "string", "description": "Phone number" },
        "email": { "type": "string", "description": "Email address" },
        "city": { "type": "string", "description": "City" },
        "eventType": { "type": "string", "description": "Event type" },
        "eventDate": { "type": "string", "description": "Target date" },
        "message": { "type": "string", "description": "Inquiry message" },
        "status": { "type": "string", "enum": ["new", "read"], "description": "Status" },
        "createdAt": { "type": "string", "description": "ISO Timestamp" }
      },
      "required": ["name", "phone", "email"]
    }
  },
  "firestore": {
    "/songs/{songId}": {
      "schema": { "$ref": "#/entities/Song" },
      "description": "Collection of devotional audio tracks"
    },
    "/lyrics/{lyricId}": {
      "schema": { "$ref": "#/entities/Lyric" },
      "description": "Collection of lyrics"
    },
    "/gallery_folders/{folderId}": {
      "schema": { "$ref": "#/entities/GalleryFolder" },
      "description": "Collection of gallery folders"
    },
    "/gallery_photos/{photoId}": {
      "schema": { "$ref": "#/entities/GalleryPhoto" },
      "description": "Collection of gallery photos and videos"
    },
    "/shows/{showId}": {
      "schema": { "$ref": "#/entities/Show" },
      "description": "Collection of upcoming and past shows"
    },
    "/hero_slides/{slideId}": {
      "schema": { "$ref": "#/entities/HeroSlide" },
      "description": "Collection of hero banner slides"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Collection of ticker notifications"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Collection of contact inquiries"
    }
  }
}
